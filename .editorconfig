# Consistent formatting across the repo. EditorConfig is honoured by most
# editors (VS Code included) — see https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts,java}]
indent_size = 4

[*.{c,cpp,h,hpp}]
indent_size = 4

[*.{xml,gradle,json,yaml,yml}]
indent_size = 4

[*.md]
# Trailing double-spaces are meaningful in Markdown (hard line break).
trim_trailing_whitespace = false

[*.bat]
# Windows batch files expect CRLF.
end_of_line = crlf